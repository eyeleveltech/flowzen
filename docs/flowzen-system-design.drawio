        <mxCell id="n2" value="Flowzen — how the system works" style="text;html=1;align=left;verticalAlign=middle;fontSize=25;fontStyle=1;fontColor=#111827;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1000" height="34" as="geometry"/></mxCell>
        <mxCell id="n3" value="One company record from first contact to final invoice. Read any column top to bottom: who acts, what they do, what the system does about it, and what it stores." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#6B7280;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="66" width="1400" height="20" as="geometry"/></mxCell>
        <mxCell id="n4" value="Colour means something —  green = money or a commitment  ·  amber = be careful here  ·  blue = a decision point  ·  red = the relationship ending" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#6B7280;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="92" width="1400" height="20" as="geometry"/></mxCell>
        <mxCell id="n5" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=#E5E7EB;" vertex="1" parent="1"><mxGeometry x="192" y="176" width="2424" height="62" as="geometry"/></mxCell>
        <mxCell id="n6" value="WHO" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontStyle=1;fontColor=#6B7280;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="150" height="40" as="geometry"/></mxCell>
        <mxCell id="n7" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=#E5E7EB;" vertex="1" parent="1"><mxGeometry x="192" y="238" width="2424" height="168" as="geometry"/></mxCell>
        <mxCell id="n8" value="WHAT THEY DO" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontStyle=1;fontColor=#6B7280;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="252" width="150" height="40" as="geometry"/></mxCell>
        <mxCell id="n9" value="" style="rounded=0;fillColor=#FAFAFA;strokeColor=#E5E7EB;" vertex="1" parent="1"><mxGeometry x="192" y="406" width="2424" height="246" as="geometry"/></mxCell>
        <mxCell id="n10" value="WHAT THE SYSTEM DOES" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontStyle=1;fontColor=#6B7280;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="150" height="40" as="geometry"/></mxCell>
        <mxCell id="n11" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=#E5E7EB;" vertex="1" parent="1"><mxGeometry x="192" y="652" width="2424" height="152" as="geometry"/></mxCell>
        <mxCell id="n12" value="WHAT IT STORES" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontStyle=1;fontColor=#6B7280;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="666" width="150" height="40" as="geometry"/></mxCell>
        <mxCell id="n13" value="1 · ARRIVE
a company appears" style="rounded=1;arcSize=16;fillColor=#111827;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontStyle=1;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="200" y="114" width="320" height="50" as="geometry"/></mxCell>
        <mxCell id="n14" value="Sales  ·  Admin" style="rounded=1;arcSize=14;fillColor=#DBEAFE;strokeColor=#93C5FD;fontColor=#1D4ED8;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="206" y="186" width="308" height="30" as="geometry"/></mxCell>
        <mxCell id="n15" value="Add a company" style="rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontColor=#374151;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="206" y="248" width="308" height="32" as="geometry"/></mxCell>
        <mxCell id="n16" value="Import a list" style="rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontColor=#374151;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="206" y="288" width="308" height="32" as="geometry"/></mxCell>
        <mxCell id="n17" value="The API posts one in" style="rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontColor=#374151;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="206" y="328" width="308" height="32" as="geometry"/></mxCell>
        <mxCell id="n18" value="Check if we already know them
by email, phone or name" style="rounded=1;arcSize=14;fillColor=#FEF3C7;strokeColor=#FCD34D;fontColor=#B45309;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="206" y="416" width="308" height="52" as="geometry"/></mxCell>
        <mxCell id="n19" value="Assign an owner
— or nothing will ever chase it" style="rounded=1;arcSize=14;fillColor=#DCFCE7;strokeColor=#86EFAC;fontColor=#15803D;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="206" y="476" width="308" height="52" as="geometry"/></mxCell>
        <mxCell id="n20" value="Set the first follow-up date" style="rounded=1;arcSize=14;fillColor=#DCFCE7;strokeColor=#86EFAC;fontColor=#15803D;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="206" y="536" width="308" height="42" as="geometry"/></mxCell>
        <mxCell id="n21" value="Company  ·  status PROSPECT" style="rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontColor=#374151;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="206" y="662" width="308" height="38" as="geometry"/></mxCell>
        <mxCell id="n22" value="Contact  ·  one marked main" style="rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontColor=#374151;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="206" y="708" width="308" height="38" as="geometry"/></mxCell>
        <mxCell id="n23" value="Activity" style="rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontColor=#374151;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="206" y="754" width="308" height="38" as="geometry"/></mxCell>
        <mxCell id="n24" value="2 · PURSUE
work the deal" style="rounded=1;arcSize=16;fillColor=#111827;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontStyle=1;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="544" y="114" width="320" height="50" as="geometry"/></mxCell>
        <mxCell id="n25" value="Sales" style="rounded=1;arcSize=14;fillColor=#DBEAFE;strokeColor=#93C5FD;fontColor=#1D4ED8;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="550" y="186" width="308" height="30" as="geometry"/></mxCell>
        <mxCell id="n26" value="Create a deal" style="rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontColor=#374151;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="550" y="248" width="308" height="32" as="geometry"/></mxCell>
        <mxCell id="n27" value="Drag across YOUR columns" style="rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontColor=#374151;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="550" y="288" width="308" height="32" as="geometry"/></mxCell>
        <mxCell id="n28" value="Log calls and meetings" style="rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontColor=#374151;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="550" y="328" width="308" height="32" as="geometry"/></mxCell>
        <mxCell id="n29" value="Park it if it stalls" style="rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontColor=#374151;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="550" y="368" width="308" height="32" as="geometry"/></mxCell>
        <mxCell id="n30" value="Record every move —
who, when, from where, to where" style="rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontColor=#374151;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="550" y="416" width="308" height="52" as="geometry"/></mxCell>
        <mxCell id="n31" value="Show how long it has sat still,
per column" style="rounded=1;arcSize=14;fillColor=#FEF3C7;strokeColor=#FCD34D;fontColor=#B45309;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="550" y="476" width="308" height="52" as="geometry"/></mxCell>
        <mxCell id="n32" value="Negotiation REQUIRES a value
and a close date" style="rounded=1;arcSize=14;fillColor=#DCFCE7;strokeColor=#86EFAC;fontColor=#15803D;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="550" y="536" width="308" height="52" as="geometry"/></mxCell>
        <mxCell id="n33" value="Deal  ·  StageHistory" style="rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontColor=#374151;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="550" y="662" width="308" height="38" as="geometry"/></mxCell>
        <mxCell id="n34" value="Activity  ·  Task" style="rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontColor=#374151;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="550" y="708" width="308" height="38" as="geometry"/></mxCell>
        <mxCell id="n35" value="isOnHold — keeps its column" style="rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontColor=#374151;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="550" y="754" width="308" height="38" as="geometry"/></mxCell>
        <mxCell id="n36" value="3 · PRICE
put a number on it" style="rounded=1;arcSize=16;fillColor=#111827;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontStyle=1;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="888" y="114" width="320" height="50" as="geometry"/></mxCell>
        <mxCell id="n37" value="Sales" style="rounded=1;arcSize=14;fillColor=#DBEAFE;strokeColor=#93C5FD;fontColor=#1D4ED8;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="894" y="186" width="308" height="30" as="geometry"/></mxCell>
        <mxCell id="n38" value="Raise a quotation" style="rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontColor=#374151;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="894" y="248" width="308" height="32" as="geometry"/></mxCell>
        <mxCell id="n39" value="Send it" style="rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontColor=#374151;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="894" y="288" width="308" height="32" as="geometry"/></mxCell>
        <mxCell id="n40" value="The server computes every total —
never trusts the browser" style="rounded=1;arcSize=14;fillColor=#FEF3C7;strokeColor=#FCD34D;fontColor=#B45309;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="894" y="416" width="308" height="52" as="geometry"/></mxCell>
        <mxCell id="n41" value="The deal value follows
the quote total" style="rounded=1;arcSize=14;fillColor=#DCFCE7;strokeColor=#86EFAC;fontColor=#15803D;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="894" y="476" width="308" height="52" as="geometry"/></mxCell>
        <mxCell id="n42" value="Numbering per organisation" style="rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontColor=#374151;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="894" y="536" width="308" height="42" as="geometry"/></mxCell>
        <mxCell id="n43" value="Quote  +  line items" style="rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontColor=#374151;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="894" y="662" width="308" height="38" as="geometry"/></mxCell>
        <mxCell id="n44" value="Activity" style="rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontColor=#374151;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="894" y="708" width="308" height="38" as="geometry"/></mxCell>
        <mxCell id="n45" value="4 · WIN
they become a customer" style="rounded=1;arcSize=16;fillColor=#111827;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontStyle=1;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1232" y="114" width="320" height="50" as="geometry"/></mxCell>
        <mxCell id="n46" value="Sales  ·  Admin" style="rounded=1;arcSize=14;fillColor=#DBEAFE;strokeColor=#93C5FD;fontColor=#1D4ED8;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1238" y="186" width="308" height="30" as="geometry"/></mxCell>
        <mxCell id="n47" value="Move to the winning column" style="rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontColor=#374151;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1238" y="248" width="308" height="32" as="geometry"/></mxCell>
        <mxCell id="n48" value="Retainer or project?" style="rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontColor=#374151;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1238" y="288" width="308" height="32" as="geometry"/></mxCell>
        <mxCell id="n49" value="When does it start?" style="rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontColor=#374151;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1238" y="328" width="308" height="32" as="geometry"/></mxCell>
        <mxCell id="n50" value="Company status → ACTIVE.
NOTHING is copied — same record" style="rounded=1;arcSize=14;fillColor=#DCFCE7;strokeColor=#86EFAC;fontColor=#15803D;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1238" y="416" width="308" height="52" as="geometry"/></mxCell>
        <mxCell id="n51" value="Create ONE engagement.
The database allows only one" style="rounded=1;arcSize=14;fillColor=#DCFCE7;strokeColor=#86EFAC;fontColor=#15803D;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1238" y="476" width="308" height="52" as="geometry"/></mxCell>
        <mxCell id="n52" value="The deal is finished
and leaves the board" style="rounded=1;arcSize=14;fillColor=#DBEAFE;strokeColor=#93C5FD;fontColor=#1D4ED8;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1238" y="536" width="308" height="52" as="geometry"/></mxCell>
        <mxCell id="n53" value="Engagement" style="rounded=1;arcSize=14;fillColor=#DCFCE7;strokeColor=#86EFAC;fontColor=#15803D;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1238" y="662" width="308" height="38" as="geometry"/></mxCell>
        <mxCell id="n54" value="EngagementRevision" style="rounded=1;arcSize=14;fillColor=#DCFCE7;strokeColor=#86EFAC;fontColor=#15803D;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1238" y="708" width="308" height="38" as="geometry"/></mxCell>
        <mxCell id="n55" value="Company → ACTIVE" style="rounded=1;arcSize=14;fillColor=#DCFCE7;strokeColor=#86EFAC;fontColor=#15803D;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1238" y="754" width="308" height="38" as="geometry"/></mxCell>
        <mxCell id="n56" value="5 · DELIVER
do the work" style="rounded=1;arcSize=16;fillColor=#111827;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontStyle=1;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1576" y="114" width="320" height="50" as="geometry"/></mxCell>
        <mxCell id="n57" value="Delivery  ·  Member" style="rounded=1;arcSize=14;fillColor=#DBEAFE;strokeColor=#93C5FD;fontColor=#1D4ED8;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1582" y="186" width="308" height="30" as="geometry"/></mxCell>
        <mxCell id="n58" value="Create a project" style="rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontColor=#374151;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1582" y="248" width="308" height="32" as="geometry"/></mxCell>
        <mxCell id="n59" value="Assign tasks and reviewers" style="rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontColor=#374151;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1582" y="288" width="308" height="32" as="geometry"/></mxCell>
        <mxCell id="n60" value="Set due dates" style="rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontColor=#374151;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1582" y="328" width="308" height="32" as="geometry"/></mxCell>
        <mxCell id="n61" value="Projects belong to the COMPANY,
not to the deal" style="rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontColor=#374151;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1582" y="416" width="308" height="52" as="geometry"/></mxCell>
        <mxCell id="n62" value="Optional link to what pays for it
→ what this delivery earns" style="rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontColor=#374151;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1582" y="476" width="308" height="52" as="geometry"/></mxCell>
        <mxCell id="n63" value="Health is COMPUTED from overdue
tasks and dates — never typed" style="rounded=1;arcSize=14;fillColor=#FEF3C7;strokeColor=#FCD34D;fontColor=#B45309;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1582" y="536" width="308" height="52" as="geometry"/></mxCell>
        <mxCell id="n64" value="Project  ·  Task" style="rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontColor=#374151;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1582" y="662" width="308" height="38" as="geometry"/></mxCell>
        <mxCell id="n65" value="Subtasks  ·  Comments" style="rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontColor=#374151;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1582" y="708" width="308" height="38" as="geometry"/></mxCell>
        <mxCell id="n66" value="Activity" style="rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontColor=#374151;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1582" y="754" width="308" height="38" as="geometry"/></mxCell>
        <mxCell id="n67" value="6 · BILL
get paid" style="rounded=1;arcSize=16;fillColor=#111827;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontStyle=1;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1920" y="114" width="320" height="50" as="geometry"/></mxCell>
        <mxCell id="n68" value="Finance  ·  Admin" style="rounded=1;arcSize=14;fillColor=#DBEAFE;strokeColor=#93C5FD;fontColor=#1D4ED8;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1926" y="186" width="308" height="30" as="geometry"/></mxCell>
        <mxCell id="n69" value="Issue an invoice" style="rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontColor=#374151;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1926" y="248" width="308" height="32" as="geometry"/></mxCell>
        <mxCell id="n70" value="Record payments" style="rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontColor=#374151;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1926" y="288" width="308" height="32" as="geometry"/></mxCell>
        <mxCell id="n71" value="Log expenses" style="rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontColor=#374151;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1926" y="328" width="308" height="32" as="geometry"/></mxCell>
        <mxCell id="n72" value="Inherits the quote totals exactly" style="rounded=1;arcSize=14;fillColor=#DCFCE7;strokeColor=#86EFAC;fontColor=#15803D;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1926" y="416" width="308" height="42" as="geometry"/></mxCell>
        <mxCell id="n73" value="FROZEN once issued — wrong?
Void it, credit-note it" style="rounded=1;arcSize=14;fillColor=#FEF3C7;strokeColor=#FCD34D;fontColor=#B45309;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1926" y="466" width="308" height="52" as="geometry"/></mxCell>
        <mxCell id="n74" value="&quot;Overdue&quot; is worked out,
never stored" style="rounded=1;arcSize=14;fillColor=#FEF3C7;strokeColor=#FCD34D;fontColor=#B45309;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1926" y="526" width="308" height="52" as="geometry"/></mxCell>
        <mxCell id="n75" value="Invoice  ·  frozen line items" style="rounded=1;arcSize=14;fillColor=#DCFCE7;strokeColor=#86EFAC;fontColor=#15803D;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1926" y="662" width="308" height="38" as="geometry"/></mxCell>
        <mxCell id="n76" value="Payment  →  the invoice" style="rounded=1;arcSize=14;fillColor=#DCFCE7;strokeColor=#86EFAC;fontColor=#15803D;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1926" y="708" width="308" height="38" as="geometry"/></mxCell>
        <mxCell id="n77" value="Expense" style="rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontColor=#374151;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1926" y="754" width="308" height="38" as="geometry"/></mxCell>
        <mxCell id="n78" value="7 · KEEP
…or lose them" style="rounded=1;arcSize=16;fillColor=#111827;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontStyle=1;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2264" y="114" width="320" height="50" as="geometry"/></mxCell>
        <mxCell id="n79" value="Admin  ·  Sales" style="rounded=1;arcSize=14;fillColor=#DBEAFE;strokeColor=#93C5FD;fontColor=#1D4ED8;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="2270" y="186" width="308" height="30" as="geometry"/></mxCell>
        <mxCell id="n80" value="Review terms every 6 months" style="rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontColor=#374151;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="2270" y="248" width="308" height="32" as="geometry"/></mxCell>
        <mxCell id="n81" value="Renew a fixed term" style="rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontColor=#374151;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="2270" y="288" width="308" height="32" as="geometry"/></mxCell>
        <mxCell id="n82" value="Or end it" style="rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontColor=#374151;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="2270" y="328" width="308" height="32" as="geometry"/></mxCell>
        <mxCell id="n83" value="ROLLING → watch the money arriving
and when terms were last reviewed" style="rounded=1;arcSize=14;fillColor=#DCFCE7;strokeColor=#86EFAC;fontColor=#15803D;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="2270" y="416" width="308" height="52" as="geometry"/></mxCell>
        <mxCell id="n84" value="FIXED TERM → prompt as the
end date approaches" style="rounded=1;arcSize=14;fillColor=#DBEAFE;strokeColor=#93C5FD;fontColor=#1D4ED8;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="2270" y="476" width="308" height="52" as="geometry"/></mxCell>
        <mxCell id="n85" value="Ending stops billing and freezes
work — unless another deal is live" style="rounded=1;arcSize=14;fillColor=#FEE2E2;strokeColor=#FCA5A5;fontColor=#B91C1C;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="2270" y="536" width="308" height="52" as="geometry"/></mxCell>
        <mxCell id="n86" value="EngagementRevision" style="rounded=1;arcSize=14;fillColor=#DCFCE7;strokeColor=#86EFAC;fontColor=#15803D;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="2270" y="662" width="308" height="38" as="geometry"/></mxCell>
        <mxCell id="n87" value="Company → CHURNED" style="rounded=1;arcSize=14;fillColor=#FEE2E2;strokeColor=#FCA5A5;fontColor=#B91C1C;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="2270" y="708" width="308" height="38" as="geometry"/></mxCell>
        <mxCell id="n88" value="Nothing is ever deleted" style="rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontColor=#374151;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="2270" y="754" width="308" height="38" as="geometry"/></mxCell>
        <mxCell id="n89" style="endArrow=classic;html=1;strokeColor=#D1D5DB;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="516" y="206" as="sourcePoint"/><mxPoint x="548" y="206" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n90" style="endArrow=classic;html=1;strokeColor=#D1D5DB;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860" y="206" as="sourcePoint"/><mxPoint x="892" y="206" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n91" style="endArrow=classic;html=1;strokeColor=#D1D5DB;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1204" y="206" as="sourcePoint"/><mxPoint x="1236" y="206" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n92" style="endArrow=classic;html=1;strokeColor=#D1D5DB;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1548" y="206" as="sourcePoint"/><mxPoint x="1580" y="206" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n93" style="endArrow=classic;html=1;strokeColor=#D1D5DB;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1892" y="206" as="sourcePoint"/><mxPoint x="1924" y="206" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n94" style="endArrow=classic;html=1;strokeColor=#D1D5DB;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2236" y="206" as="sourcePoint"/><mxPoint x="2268" y="206" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n95" value="renewed — it keeps running" style="endArrow=classic;html=1;strokeColor=#15803D;strokeWidth=2;dashed=1;fontColor=#15803D;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2424" y="804" as="sourcePoint"/><mxPoint x="1736" y="804" as="targetPoint"/><Array as="points"><mxPoint x="2424" y="838"/><mxPoint x="1736" y="838"/></Array></mxGeometry></mxCell>
        <mxCell id="n96" value="The rules that hold everywhere" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#111827;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="864" width="500" height="24" as="geometry"/></mxCell>
        <mxCell id="n97" value="&lt;b&gt;One company record — prospect or customer&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#6B7280&quot; style=&quot;font-size:11px&quot;&gt;two records for one organisation always drift apart&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#111827;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="900" width="1040" height="32" as="geometry"/></mxCell>
        <mxCell id="n98" value="&lt;b&gt;A company becomes a customer only by winning a deal&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#6B7280&quot; style=&quot;font-size:11px&quot;&gt;so the customer list and the pipeline cannot disagree&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#111827;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1120" y="900" width="1040" height="32" as="geometry"/></mxCell>
        <mxCell id="n99" value="&lt;b&gt;One company, many deals&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#6B7280&quot; style=&quot;font-size:11px&quot;&gt;customers come back, and buy more than one thing&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#111827;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="938" width="1040" height="32" as="geometry"/></mxCell>
        <mxCell id="n100" value="&lt;b&gt;The pipeline ends at won or lost&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#6B7280&quot; style=&quot;font-size:11px&quot;&gt;after that it is a relationship, not a pursuit&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#111827;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1120" y="938" width="1040" height="32" as="geometry"/></mxCell>
        <mxCell id="n101" value="&lt;b&gt;The kind of work is decided at the win&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#6B7280&quot; style=&quot;font-size:11px&quot;&gt;retainers and projects bill differently from day one&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#111827;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="976" width="1040" height="32" as="geometry"/></mxCell>
        <mxCell id="n102" value="&lt;b&gt;One engagement per won deal, enforced by the database&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#6B7280&quot; style=&quot;font-size:11px&quot;&gt;two clicks at the same instant must not bill twice&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#111827;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1120" y="976" width="1040" height="32" as="geometry"/></mxCell>
        <mxCell id="n103" value="&lt;b&gt;No end date means it simply runs&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#6B7280&quot; style=&quot;font-size:11px&quot;&gt;most retainers do — inventing a date invents a deadline&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#111827;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="1014" width="1040" height="32" as="geometry"/></mxCell>
        <mxCell id="n104" value="&lt;b&gt;Rolling engagements are reviewed, not renewed&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#6B7280&quot; style=&quot;font-size:11px&quot;&gt;the risk is not expiry, it is a price that never moved&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#111827;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1120" y="1014" width="1040" height="32" as="geometry"/></mxCell>
        <mxCell id="n105" value="&lt;b&gt;Parking a deal and pausing a customer are different&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#6B7280&quot; style=&quot;font-size:11px&quot;&gt;one stops nothing, the other stops money&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#111827;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="1052" width="1040" height="32" as="geometry"/></mxCell>
        <mxCell id="n106" value="&lt;b&gt;Nothing is deleted, only retired&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#6B7280&quot; style=&quot;font-size:11px&quot;&gt;history stays true, and customers come back&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#111827;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1120" y="1052" width="1040" height="32" as="geometry"/></mxCell>
        <mxCell id="n107" value="&lt;b&gt;Gross margin, never profit&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#6B7280&quot; style=&quot;font-size:11px&quot;&gt;no time tracking, no cost rates - it never claims to know what work cost&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#111827;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="1090" width="1040" height="32" as="geometry"/></mxCell>
        <mxCell id="n108" value="&lt;b&gt;Rules are enforced on the server&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#6B7280&quot; style=&quot;font-size:11px&quot;&gt;a rule the API can skip is not a rule&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#111827;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1120" y="1090" width="1040" height="32" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
