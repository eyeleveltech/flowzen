        <mxCell id="n73" value="Time × cost rate
→ project profitability" style="rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontColor=#374151;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1816" y="572" width="288" height="50" as="geometry"/></mxCell>
        <mxCell id="n74" value="Project  ·  Task ×n" style="rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontColor=#374151;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1816" y="686" width="288" height="38" as="geometry"/></mxCell>
        <mxCell id="n75" value="TimeEntry" style="rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontColor=#374151;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1816" y="732" width="288" height="38" as="geometry"/></mxCell>
        <mxCell id="n76" value="Notification" style="rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontColor=#374151;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1816" y="778" width="288" height="38" as="geometry"/></mxCell>
        <mxCell id="n77" value="7 · BILL
get paid" style="rounded=1;arcSize=16;fillColor=#111827;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontStyle=1;html=1;whiteSpace=wrap;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2134" y="106" width="300" height="50" as="geometry"/></mxCell>
        <mxCell id="n78" value="Accept the quote" style="rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontColor=#374151;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2140" y="178" width="288" height="32" as="geometry"/></mxCell>
        <mxCell id="n79" value="Generate an invoice draft" style="rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontColor=#374151;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2140" y="218" width="288" height="32" as="geometry"/></mxCell>
        <mxCell id="n80" value="Record the payment" style="rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontColor=#374151;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2140" y="258" width="288" height="32" as="geometry"/></mxCell>
        <mxCell id="n81" value="Invoice Drafts · Payments" style="rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontColor=#374151;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2140" y="356" width="288" height="38" as="geometry"/></mxCell>
        <mxCell id="n82" value="Draft inherits totals from the
ACCEPTED quote, not the browser" style="rounded=1;arcSize=14;fillColor=#FEF3C7;strokeColor=#FCD34D;fontColor=#B45309;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2140" y="456" width="288" height="50" as="geometry"/></mxCell>
        <mxCell id="n83" value="Accepted quote also mints
its Contract" style="rounded=1;arcSize=14;fillColor=#DCFCE7;strokeColor=#86EFAC;fontColor=#15803D;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2140" y="514" width="288" height="50" as="geometry"/></mxCell>
        <mxCell id="n84" value="Unpaid balance → Receivables" style="rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontColor=#374151;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2140" y="572" width="288" height="40" as="geometry"/></mxCell>
        <mxCell id="n85" value="InvoiceDraft" style="rounded=1;arcSize=14;fillColor=#DCFCE7;strokeColor=#86EFAC;fontColor=#15803D;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2140" y="686" width="288" height="38" as="geometry"/></mxCell>
        <mxCell id="n86" value="Payment" style="rounded=1;arcSize=14;fillColor=#DCFCE7;strokeColor=#86EFAC;fontColor=#15803D;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2140" y="732" width="288" height="38" as="geometry"/></mxCell>
        <mxCell id="n87" value="Expense  ·  P&amp;L" style="rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontColor=#374151;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2140" y="778" width="288" height="38" as="geometry"/></mxCell>
        <mxCell id="n88" value="8 · RENEW / CLOSE
or lose it" style="rounded=1;arcSize=16;fillColor=#111827;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontStyle=1;html=1;whiteSpace=wrap;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2458" y="106" width="300" height="50" as="geometry"/></mxCell>
        <mxCell id="n89" value="Renew the retainer" style="rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontColor=#374151;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2464" y="178" width="288" height="32" as="geometry"/></mxCell>
        <mxCell id="n90" value="Mark project completed" style="rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontColor=#374151;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2464" y="218" width="288" height="32" as="geometry"/></mxCell>
        <mxCell id="n91" value="Or mark it lost" style="rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontColor=#374151;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2464" y="258" width="288" height="32" as="geometry"/></mxCell>
        <mxCell id="n92" value="Renewals · Pipeline" style="rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontColor=#374151;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2464" y="356" width="288" height="38" as="geometry"/></mxCell>
        <mxCell id="n93" value="Renewals watches contractEndDate
on ACTIVE_RETAINER leads" style="rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontColor=#374151;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2464" y="456" width="288" height="50" as="geometry"/></mxCell>
        <mxCell id="n94" value="CHURNED → subscriptions cancelled,
contracts terminated, projects held" style="rounded=1;arcSize=14;fillColor=#FEE2E2;strokeColor=#FCA5A5;fontColor=#B91C1C;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2464" y="514" width="288" height="50" as="geometry"/></mxCell>
        <mxCell id="n95" value="Checks for a sibling live deal
before freezing anything" style="rounded=1;arcSize=14;fillColor=#FEF3C7;strokeColor=#FCD34D;fontColor=#B45309;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2464" y="572" width="288" height="50" as="geometry"/></mxCell>
        <mxCell id="n96" value="Client → CHURNED / COMPLETED" style="rounded=1;arcSize=14;fillColor=#FEE2E2;strokeColor=#FCA5A5;fontColor=#B91C1C;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2464" y="686" width="288" height="38" as="geometry"/></mxCell>
        <mxCell id="n97" value="Subscription → CANCELLED" style="rounded=1;arcSize=14;fillColor=#FEE2E2;strokeColor=#FCA5A5;fontColor=#B91C1C;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2464" y="732" width="288" height="38" as="geometry"/></mxCell>
        <mxCell id="n98" value="Lead stays as the audit trail" style="rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontColor=#374151;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2464" y="778" width="288" height="38" as="geometry"/></mxCell>
        <mxCell id="n99" style="endArrow=classic;html=1;strokeColor=#D1D5DB;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="486" y="396" as="sourcePoint"/><mxPoint x="518" y="396" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n100" style="endArrow=classic;html=1;strokeColor=#D1D5DB;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="810" y="396" as="sourcePoint"/><mxPoint x="842" y="396" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n101" style="endArrow=classic;html=1;strokeColor=#D1D5DB;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1134" y="396" as="sourcePoint"/><mxPoint x="1166" y="396" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n102" style="endArrow=classic;html=1;strokeColor=#D1D5DB;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1458" y="396" as="sourcePoint"/><mxPoint x="1490" y="396" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n103" style="endArrow=classic;html=1;strokeColor=#D1D5DB;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1782" y="396" as="sourcePoint"/><mxPoint x="1814" y="396" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n104" style="endArrow=classic;html=1;strokeColor=#D1D5DB;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2106" y="396" as="sourcePoint"/><mxPoint x="2138" y="396" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n105" style="endArrow=classic;html=1;strokeColor=#D1D5DB;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2430" y="396" as="sourcePoint"/><mxPoint x="2462" y="396" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n106" value="Rules that hold everywhere" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#111827;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="872" width="400" height="24" as="geometry"/></mxCell>
        <mxCell id="n107" value="&lt;b&gt;A Client is born only at a win, or by import&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#6B7280&quot; style=&quot;font-size:11px&quot;&gt;POST /clients is a deliberate 403&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#111827;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="906" width="730" height="34" as="geometry"/></mxCell>
        <mxCell id="n108" value="&lt;b&gt;Winning creates no money&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#6B7280&quot; style=&quot;font-size:11px&quot;&gt;the record appears at Active, where retainer vs project is known&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#111827;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="800" y="906" width="730" height="34" as="geometry"/></mxCell>
        <mxCell id="n109" value="&lt;b&gt;One account, many deals&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#6B7280&quot; style=&quot;font-size:11px&quot;&gt;Lead.clientId is deliberately not unique — repeat business&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#111827;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="948" width="730" height="34" as="geometry"/></mxCell>
        <mxCell id="n110" value="&lt;b&gt;Deleting a lead never deletes the account&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#6B7280&quot; style=&quot;font-size:11px&quot;&gt;onDelete: SetNull keeps projects, payments, history&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#111827;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="800" y="948" width="730" height="34" as="geometry"/></mxCell>
        <mxCell id="n111" value="&lt;b&gt;Client status is never hand-set&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#6B7280&quot; style=&quot;font-size:11px&quot;&gt;it is driven entirely by the deal stage cascade&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#111827;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="990" width="730" height="34" as="geometry"/></mxCell>
        <mxCell id="n112" value="&lt;b&gt;Revenue is idempotent per deal&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#6B7280&quot; style=&quot;font-size:11px&quot;&gt;keyed on sourceLeadId — a deal re-entering Active never bills twice&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#111827;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="800" y="990" width="730" height="34" as="geometry"/></mxCell>
        <mxCell id="n113" value="KNOWN GAPS

· Dragging to &quot;Active&quot; always makes it a RETAINER —
  Active (Project) is unreachable from the UI
· Imported won deals get no Subscription/Contract
· PROJECT_MANAGER and TEAM_MEMBER cannot open the CRM" style="rounded=1;arcSize=14;fillColor=#FEF3C7;strokeColor=#FCD34D;fontColor=#B45309;fontSize=11;html=1;whiteSpace=wrap;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1580" y="906" width="420" height="118" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
