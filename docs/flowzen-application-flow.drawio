        <mxCell id="e33" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9CA3AF;strokeWidth=1.8;fontSize=10;fontColor=#6B7280;endArrow=classic;" edge="1" parent="1" source="endq" target="roll"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
