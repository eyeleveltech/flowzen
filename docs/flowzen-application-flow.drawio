        <mxCell id="e35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9CA3AF;strokeWidth=1.8;fontSize=10;fontColor=#6B7280;endArrow=classic;" edge="1" parent="1" source="roll" target="inv"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9CA3AF;strokeWidth=1.8;fontSize=10;fontColor=#6B7280;endArrow=classic;" edge="1" parent="1" source="fixed" target="inv"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1840" y="899"/><mxPoint x="1840" y="835"/></Array></mxGeometry></mxCell>
        <mxCell id="e37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9CA3AF;strokeWidth=1.8;fontSize=10;fontColor=#6B7280;endArrow=classic;" edge="1" parent="1" source="inv" target="pay"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9CA3AF;strokeWidth=1.8;fontSize=10;fontColor=#6B7280;endArrow=classic;" edge="1" parent="1" source="pay" target="gm"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2365" y="836"/><mxPoint x="2365" y="864"/></Array></mxGeometry></mxCell>
        <mxCell id="e39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9CA3AF;strokeWidth=1.8;fontSize=10;fontColor=#6B7280;endArrow=classic;" edge="1" parent="1" source="exp" target="gm"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2365" y="902"/><mxPoint x="2365" y="864"/></Array></mxGeometry></mxCell>
        <mxCell id="e40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9CA3AF;strokeWidth=1.8;fontSize=10;fontColor=#6B7280;endArrow=classic;" edge="1" parent="1" source="roll" target="review"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1700" y="930"/><mxPoint x="1710" y="930"/></Array></mxGeometry></mxCell>
        <mxCell id="e41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9CA3AF;strokeWidth=1.8;fontSize=10;fontColor=#6B7280;endArrow=classic;" edge="1" parent="1" source="fixed" target="review"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1700" y="930"/><mxPoint x="1710" y="930"/></Array></mxGeometry></mxCell>
        <mxCell id="e42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9CA3AF;strokeWidth=1.8;fontSize=10;fontColor=#6B7280;endArrow=classic;" edge="1" parent="1" source="review" target="rev2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9CA3AF;strokeWidth=1.8;fontSize=10;fontColor=#6B7280;endArrow=classic;" edge="1" parent="1" source="review" target="endit"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1710" y="1014"/><mxPoint x="1710" y="1014"/></Array></mxGeometry></mxCell>
        <mxCell id="e44" value="the engagement continues" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9CA3AF;strokeWidth=1.8;fontSize=10;fontColor=#6B7280;endArrow=classic;" edge="1" parent="1" source="review" target="eng"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1550" y="978"/><mxPoint x="1550" y="1050"/><mxPoint x="740" y="1050"/></Array></mxGeometry></mxCell>
        <mxCell id="e45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9CA3AF;strokeWidth=1.8;fontSize=10;fontColor=#6B7280;endArrow=classic;" edge="1" parent="1" source="endit" target="coChurn"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1710" y="1008"/><mxPoint x="1625" y="1008"/></Array></mxGeometry></mxCell>
        <mxCell id="t46" value="Nothing asked —
the drag is the action" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#6B7280;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1086" y="244" width="260" height="46" as="geometry"/></mxCell>
        <mxCell id="t47" value="Meeting logged
as an activity" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#6B7280;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1378" y="244" width="260" height="46" as="geometry"/></mxCell>
        <mxCell id="t48" value="A quotation
is raised" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#6B7280;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1524" y="244" width="260" height="46" as="geometry"/></mxCell>
        <mxCell id="t49" value="REQUIRED: value
+ close date" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#B45309;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1670" y="244" width="260" height="46" as="geometry"/></mxCell>
        <mxCell id="t50" value="Along the way: log calls and meetings · add contacts · create tasks · set follow-ups · park a stalled deal (it keeps its stage) · every move written to history" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#6B7280;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1086" y="298" width="900" height="46" as="geometry"/></mxCell>
        <mxCell id="t51" value="A lost deal never reopens.
If they return, that is a NEW deal." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#B91C1C;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1996" y="206" width="220" height="46" as="geometry"/></mxCell>
        <mxCell id="t52" value="A company is ONE record whether or not they have ever bought. Winning changes its status — it does not create a second record." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#6B7280;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="630" y="488" width="520" height="46" as="geometry"/></mxCell>
        <mxCell id="t53" value="Pausing a CUSTOMER is a
deliberate action here — not a
side effect of dragging a deal." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#B45309;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1730" y="410" width="260" height="46" as="geometry"/></mxCell>
        <mxCell id="t54" value="Delivery hangs off the company, not the deal — a customer won three times has one body of work." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#6B7280;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="630" y="696" width="250" height="46" as="geometry"/></mxCell>
        <mxCell id="t55" value="Recurring tasks cover retainer work
that repeats every month.
Tasks also appear on the calendar." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#6B7280;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1660" y="610" width="280" height="46" as="geometry"/></mxCell>
        <mxCell id="t56" value="Winning creates the engagement.
The deal is finished and leaves the board." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#6B7280;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="630" y="898" width="250" height="46" as="geometry"/></mxCell>
        <mxCell id="t57" value="No end date is not missing data —
it means &quot;this one just runs&quot;." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#6B7280;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1390" y="886" width="230" height="46" as="geometry"/></mxCell>
        <mxCell id="t58" value="Overdue is worked out, never stored.
Wrong invoice? Void + credit note." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#6B7280;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1870" y="882" width="250" height="46" as="geometry"/></mxCell>
        <mxCell id="t59" value="Flowzen does not track hours or
cost rates, so it reports gross
margin and never claims profit." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#B45309;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2390" y="898" width="240" height="46" as="geometry"/></mxCell>
        <mxCell id="ttl" value="Flowzen — the complete application flow" style="text;html=1;align=left;fontSize=26;fontStyle=1;fontColor=#111827;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1200" height="36" as="geometry"/></mxCell>
        <mxCell id="sub" value="A lead arrives, becomes a deal, is won, becomes a customer, gets delivered and billed, and is kept or lost. Follow the arrows." style="text;html=1;align=left;fontSize=13;fontColor=#6B7280;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1400" height="20" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
