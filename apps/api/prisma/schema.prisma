// ══════════════════════════════════════════════════════════════════════════════
// FLOWZEN — TARGET PRISMA SCHEMA
// Reference: docs/MASTER_ARCHITECTURE_PLAN.md & docs/SCHEMA_PLAN.md
// ══════════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────────────────────────────────────
// 1. TENANCY & USERS
// ──────────────────────────────────────────────────────────────────────────────

enum RolePreset {
  EMPLOYEE
  HEAD
  BD
  ACCOUNTS
  MANAGEMENT
}

model Organization {
  id                 String   @id @default(cuid())
  name               String
  /// Which model provider Zen asks: GEMINI, OPENAI, ANTHROPIC or
  /// OPENAI_COMPATIBLE.
  ///
  /// A plain string rather than a Prisma enum on purpose — the list of
  /// providers lives in `services/ai`, and making it an enum would mean a
  /// migration every time one is added. `providerFor` falls back to Gemini for
  /// a value it does not know, so a bad row degrades rather than 500s.
  aiProvider         String   @default("GEMINI")
  /// The key Zen answers with.
  ///
  /// On the organisation rather than in the environment so it can be changed
  /// from Settings without a deploy. It is WRITE-ONLY across the wire:
  /// `/config` never returns it and never has to, because the browser only
  /// needs to know whether one is set and the model is only ever called
  /// server-side. A key that reaches a browser is a key on every laptop.
  aiApiKey           String?
  /// Which model to ask. Here rather than compiled in, so a newer one can be
  /// switched to without a deploy.
  aiModel            String   @default("gemini-2.5-flash")
  /// Where to send it, for a provider that has no fixed home.
  ///
  /// Null for the three named providers, which know their own endpoints. Set
  /// for OPENAI_COMPATIBLE, where the whole point is that the person chooses —
  /// OpenRouter, Groq, a local server.
  aiBaseUrl          String?
  proformaPrefix     String   @default("EL/PI")
  financialYearStart Int      @default(4) // April = 4
  timezone           String   @default("Asia/Kolkata")
  currency           String   @default("INR")
  workingHoursStart  String   @default("10:00")
  workingHoursEnd    String   @default("19:00")
  workingDays        Int[]    @default([1, 2, 3, 4, 5, 6]) // Mon-Sat (0=Sun)
  /// §14 — "Sundays and public holidays excluded". `workingDays` handled the
  /// Sundays; nothing handled the holidays, so Pongal and Diwali counted as
  /// working time and every elapsed figure was overstated. ISO "YYYY-MM-DD"
  /// dates, because a public holiday is a specific day, not a weekday rule.
  holidays           String[] @default([])

  // Organisation identity — Settings' own "Organisation" tab has always
  // collected these; there was nowhere real for them to land.
  website            String?
  phone              String?
  address            String? @db.Text
  state              String?
  gstNumber          String?
  allowPasswordLogin Boolean @default(true)

  // Outbound mail — org-level override of the deployment's own SMTP account
  // (see utils/mailer.ts). Null host means "use the environment's", not
  // "sending is off"; MailSettings.via tells the UI which one is live.
  smtpHost              String?
  smtpPort              Int?
  smtpUser              String?
  // At rest via utils/crypto.ts, keyed off JWT_SECRET — never the plain
  // value, and never sent back to the client once saved.
  smtpPasswordEncrypted String?
  mailFromName          String?
  mailFromEmail         String?
  mailReplyTo           String?

  // Document letterhead — what a proforma/invoice PDF puts on itself for the
  // business raising it. Kept here, not hardcoded in the PDF template, so it
  // is one place to fix if the bank changes rather than a code change.
  contactEmail                String?
  gstStateCode                String? @default("33") // first 2 digits of GSTIN; decides CGST+SGST vs IGST. 33 = Tamil Nadu.
  bankAccountHolderName       String?
  bankName                    String?
  bankBranch                  String?
  bankAccountNumber           String?
  bankIfscCode                String?
  defaultPaymentTerms         String  @default("Immediate")
  defaultProformaValidityDays Int     @default(30)

  /// §14 — "Stage probabilities ... All configurable in Setup." They were
  /// hardcoded in two places and both disagreed with the brief's defaults
  /// (30/60/85/90), which mattered because §8 computes weighted pipeline as
  /// value × probability: every weighted figure on the board and the forecast
  /// was built on numbers nothing authorised.
  ///
  /// Columns rather than a JSON blob so a bad value cannot be written, and so
  /// the API and the web read the same typed shape.
  ///
  /// There is no figure for Talking because there is no Talking: §14 prices a
  /// proposal from Proposal sent, and the stage that sat in front of it was
  /// removed once it turned out not to work. It held an empty proposal that
  /// adding a company created by itself, which no quote lay behind, which
  /// could not be advanced, and which had to be deleted by hand.
  stageProbProposalSent     Int      @default(30)
  stageProbInNegotiation    Int      @default(60)
  stageProbProformaIssued   Int      @default(85)
  stageProbVerbalYes        Int      @default(90)
  defaultTermsAndConditions String[] @default(["Monthly retainer fee applicable", "Ad spend to be borne separately by the client", "Work execution begins upon confirmation and payment"])

  /// CR-02 §2 — the seller block. Entered once here, printed on every proforma
  /// and invoice, and snapshotted onto each document as it is raised so that
  /// editing this later never rewrites a document already sent to a client.
  ///
  /// The trading name in the header is `name` above; this is the registered
  /// entity on the tax document, which is often not the same string.
  legalName          String?
  pan                String?
  /// A scanned signature, held as a data URI rather than a file path: there is
  /// no object storage in this deployment, the image is a few KB, and a PDF
  /// renderer that reads it out of the same row it reads the address from
  /// cannot go looking for a file that is not on the box it is running on.
  signatureImage     String?  @db.Text
  /// The declaration printed above the signature on a TAX INVOICE. A proforma
  /// prints the fixed statutory line instead (services/documentModel.ts) —
  /// "This is not a tax invoice." is not something anyone should edit away.
  declarationText    String?  @db.Text
  /// The HSN/SAC codes this business actually bills under, so a line item
  /// offers them rather than asking someone to remember six digits (CR-02 §5).
  sacCodes           String[] @default([])
  /// Whether to print the "For <legal name> / Authorised Signatory" box at the
  /// foot of a document. Nothing in GST law requires it — Rule 46 asks for a
  /// signature or digital signature, which a document sent by email over a
  /// signed covering mail already satisfies in practice — so it is a choice,
  /// not a field. Defaults true because that is how every document raised
  /// before this setting existed was printed.
  showSignatureBlock Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  companies       Company[]
  outreachEntries OutreachEntry[]
  proposals       Proposal[]
  proformas       Proforma[]
  retainers       Retainer[]
  projects        Project[]
  tasks           Task[]
  costs           Cost[]
  invoices        Invoice[]
  alerts          Alert[]
  activities      Activity[]
  assets          Asset[]

  /// "EL" -> EL/CAM/001. The stickers get printed once, so this is a setting
  /// rather than a constant, but changing it does not renumber what exists.
  assetTagPrefix String @default("EL")

  @@map("organizations")
}

model User {
  id                   String     @id @default(cuid())
  organizationId       String
  name                 String
  email                String     @unique
  passwordHash         String
  dept                 String // Design, Video, Marketing, Dev, BD, Art, Accounts
  /// Own-account detail, editable only from /profile. Nobody promotes
  /// themselves, so `preset` is deliberately absent from that screen — these
  /// two are the whole of what a person may change about their own record.
  designation          String?
  phone                String?
  monthlyCost          Decimal    @db.Decimal(12, 2) // CTC/month · setup.admin access only
  preset               RolePreset @default(EMPLOYEE)
  permissions          String[] // Array of permission keys overriding preset
  active               Boolean    @default(true)
  /// Set on invite, cleared once accepted. `active: false` between the two
  /// is what keeps an invited-not-yet-accepted person out of assignee
  /// pickers and off the team roster without a third status enum.
  inviteToken          String?    @unique
  inviteTokenExpiresAt DateTime?
  /// A one-hour link an admin hands over when somebody is locked out. Separate
  /// from inviteToken so issuing one cannot cancel a pending invitation.
  resetToken           String?    @unique
  resetTokenExpiresAt  DateTime?
  /// Tokens issued before this instant are refused (middleware/auth.ts).
  /// Sessions are stateless JWTs, so this is the only way a password change
  /// can do what /profile promises it does — end every OTHER session too.
  /// Null means "nothing has ever invalidated this account's sessions".
  sessionsValidFrom    DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ownedCompanies       Company[]          @relation("CompanyOwner")
  retainerProjects     RetainerProject[]  @relation("RetainerProjectOwner")
  ownedProposals       Proposal[]         @relation("ProposalOwner")
  ownedOutreach        OutreachEntry[]    @relation("OutreachOwner")
  ownedRetainers       Retainer[]         @relation("RetainerOwner")
  ownedProjects        Project[]          @relation("ProjectOwner")
  assignedTasks        Task[]             @relation("TaskAssignee")
  createdTasks         Task[]             @relation("TaskCreator")
  handedOutTasks       Task[]             @relation("TaskAssignedBy")
  reviewingTasks       Task[]             @relation("TaskReviewer")
  taskAssignments      TaskAssignee[]     @relation("TaskAssignments")
  enteredCosts         Cost[]             @relation("CostEnteredBy")
  allocations          PeopleAllocation[] @relation("UserAllocations")
  confirmedAllocations PeopleAllocation[] @relation("AllocationConfirmedBy")
  acknowledgedAlerts   Alert[]            @relation("AlertAcknowledgedBy")
  alertReads           AlertRead[]
  activities           Activity[]         @relation("ActorActivity")
  heldAssets           Asset[]            @relation("AssetHolder")
  assetMovements       AssetMovement[]    @relation("AssetMovementHolder")
  issuedMovements      AssetMovement[]    @relation("AssetMovementIssuer")
  receivedMovements    AssetMovement[]    @relation("AssetMovementReceiver")
  createdMaintenance   AssetMaintenance[] @relation("MaintenanceCreator")

  @@index([organizationId, active])
  @@map("users")
}

// ──────────────────────────────────────────────────────────────────────────────
// 2. CRM & CLIENT SPINE
// ──────────────────────────────────────────────────────────────────────────────



enum CompanyStatus {
  PROSPECT
  CLIENT
  PAST
}

model Company {
  id             String          @id @default(cuid())
  organizationId String
  name           String
  /// What the company does, from `INDUSTRIES` in @flowzen/shared.
  ///
  /// A string rather than an enum: the list is sixty-seven long and exists to
  /// grow, and an enum would mean a migration every time the studio takes on a
  /// kind of work it has not done before. The API validates against the shared
  /// list, so an unknown value is refused at the door rather than by Postgres.
  vertical       String
  /// Where the lead came from, from `LEAD_SOURCES` in @flowzen/shared.
  source         String          @default("Cold Outreach")
  ownerId        String?
  city           String
  website        String?
  gstin          String?
  billingAddress String?         @db.Text
  /// CR-02 §3. A code plus a name rather than either alone: the code is what
  /// decides CGST+SGST vs IGST, and the name is what prints. Both, because
  /// deriving the code from the GSTIN is exactly the bug this fixes — a client
  /// with no GSTIN then reads as same-state and is charged the wrong tax.
  stateName      String?
  stateCode      String?
  lostReason     String?
  status         CompanyStatus   @default(PROSPECT)
  archivedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner         User?          @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  people        Person[]
  proposals     Proposal[]
  proformas     Proforma[]
  retainers     Retainer[]
  projects      Project[]
  invoices      Invoice[]
  outreachEntry OutreachEntry? @relation("PromotedCompany")

  @@unique([organizationId, name])
  @@index([organizationId, status])
  @@index([ownerId])
  @@map("companies")
}

enum PersonRole {
  APPROVER
  PAYER
  CONTACT
}

model Person {
  id        String     @id @default(cuid())
  companyId String
  name      String
  role      PersonRole @default(CONTACT)
  email     String?
  phone     String?
  linkedin  String?
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, active])
  @@map("people")
}

/// Where a cold lead's conversation has actually got to.
///
/// The old set (NOT_CONTACTED / CONTACTED / REPLIED / DEAD) recorded EVENTS —
/// it could tell you a call happened and never what to do next, which is why
/// CONTACTED was a dead end. These five describe a conversation with a next
/// action attached, so the list can answer "who do I call today".
///
/// FOLLOW_UP and MEETING both carry `nextActionDate`; see OutreachEntry.
/// INTERESTED is the only status that unlocks promotion to a Company, and it
/// means more than the REPLIED it replaces: met, happy, and asking for a quote.
enum OutreachStatus {
  NOT_CONTACTED
  FOLLOW_UP
  MEETING
  INTERESTED
  DEAD
}

model OutreachEntry {
  id                String          @id @default(cuid())
  organizationId    String
  name              String
  /// What the company does, from `INDUSTRIES` in @flowzen/shared.
  ///
  /// A string rather than an enum: the list is sixty-seven long and exists to
  /// grow, and an enum would mean a migration every time the studio takes on a
  /// kind of work it has not done before. The API validates against the shared
  /// list, so an unknown value is refused at the door rather than by Postgres.
  vertical          String
  /// Where the lead came from, from `LEAD_SOURCES` in @flowzen/shared.
  source            String          @default("Cold Outreach")
  ownerId           String?
  status            OutreachStatus  @default(NOT_CONTACTED)
  /// Who to ask for. Carried into the Person row on promotion.
  contactPersonName String?
  /// At least one of `phone` and `email` must be present — a name you cannot
  /// reach is a note, not a lead. Enforced by the Zod schema on both write
  /// paths and by a CHECK constraint (added NOT VALID, so the rows that
  /// predate the rule are left alone).
  phone             String?
  email             String?
  /// The latest call note. The full trail is in Activity — status changes
  /// write one row each, so a lead followed up four times keeps four notes.
  /// This column is what the row shows; it is not the history.
  remarks           String?         @db.Text
  /// One column, two meanings, set by the status: the day we agreed to call
  /// back (FOLLOW_UP) or the day of the meeting (MEETING). Deliberately NOT
  /// called `followUpDate` — it holds meeting dates too, and that name already
  /// means something different on the company form.
  nextActionDate    DateTime?       @db.Date
  promotedCompanyId String?         @unique
  importedAt        DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // `ownerId` has been written since the first version — POST defaults it to
  // whoever added the name, and the CSV import to whoever imported — but there
  // was no relation here, so Prisma had nothing to include and the Owner
  // column on /outreach rendered "—" for all seven rows while every one of
  // them actually belonged to Varsha, Tanuja or Harish.
  owner           User?        @relation("OutreachOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  promotedCompany Company?     @relation("PromotedCompany", fields: [promotedCompanyId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@map("outreach_entries")
}

// ──────────────────────────────────────────────────────────────────────────────
// 3. SALES, PROPOSALS & PROFORMAS
// ──────────────────────────────────────────────────────────────────────────────

enum ProposalKind {
  RETAINER
  PROJECT
}

enum ProposalStage {
  PROPOSAL_SENT
  IN_NEGOTIATION
  PROFORMA_ISSUED
  VERBAL_YES
  WON
  LOST
  EXPIRED
}

enum ProposalOutcome {
  WON
  LOST
  EXPIRED
}

model Proposal {
  id                  String           @id @default(cuid())
  organizationId      String
  companyId           String
  kind                ProposalKind
  ownerId             String
  stage               ProposalStage    @default(PROPOSAL_SENT)
  outcome             ProposalOutcome?
  wonVersionId        String?          @unique
  wonAt               DateTime?
  lostReason          String?
  probabilityOverride Int?
  verbalYesAt         DateTime?
  /// §16: soft delete only. A proposal logged by mistake leaves; one that
  /// was won or lost stays, because the funnel, the win rate and the
  /// handoff to a project or retainer all read outcomes that a delete
  /// would silently rewrite.
  deletedAt           DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company      Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  owner        User              @relation("ProposalOwner", fields: [ownerId], references: [id])
  wonVersion   ProposalVersion?  @relation("WonVersion", fields: [wonVersionId], references: [id])
  versions     ProposalVersion[] @relation("ProposalVersions")

  @@index([organizationId, stage])
  @@index([companyId])
  @@index([ownerId])
  @@map("proposals")
}

model ProposalVersion {
  id           String   @id @default(cuid())
  proposalId   String
  n            Int // 1, 2, 3...
  value        Decimal  @db.Decimal(12, 2)
  scopeSummary String
  sentAt       DateTime @default(now())
  fileUrl      String?
  createdAt    DateTime @default(now())

  proposal   Proposal  @relation("ProposalVersions", fields: [proposalId], references: [id], onDelete: Cascade)
  winningFor Proposal? @relation("WonVersion")

  @@unique([proposalId, n])
  @@map("proposal_versions")
}

enum ProformaStatus {
  UNPAID
  PAID
  EXPIRED
  CANCELLED
}

enum ProformaSourceType {
  PROPOSAL
  MONTH_CARD
  PROJECT
}

model Proforma {
  id                 String             @id @default(cuid())
  organizationId     String
  number             String
  companyId          String
  sourceType         ProformaSourceType
  sourceId           String
  /// Set when this proforma is raised against a specific project milestone
  /// (§11.3 step 5) rather than the project or proposal in general — a real
  /// foreign key, unlike sourceId, because "which milestone" is a genuine
  /// relationship the milestone billing UI needs to query, not just a label.
  milestoneId        String?
  amount             Decimal            @db.Decimal(12, 2)
  raisedAt           DateTime           @db.Date
  validTill          DateTime           @db.Date
  status             ProformaStatus     @default(UNPAID)
  invoiceId          String?            @unique
  billingName        String
  /// The person the document is addressed to, e.g. "Ganesh" — printed under
  /// billingName, snapshotted the same way and for the same reason: who was
  /// the contact on the day this was raised shouldn't drift with the org's
  /// current People records.
  billingContactName String?
  billingAddress     String?            @db.Text
  gstin              String?
  /// Whether tax applies to this document at all — off for e.g. an export
  /// invoice or a client explicitly billed GST-exempt. When false the PDF
  /// drops the tax rows entirely rather than printing a 0% line.
  gstApplicable      Boolean            @default(true)
  /// The rate applied when gstApplicable is true. Defaults to 18% (the
  /// standard rate for agency services) but overridable per document —
  /// India's other GST slabs (5/12/28, or a client-negotiated rate) are
  /// real cases this needs to cover, not just the common one.
  gstRatePercent     Int                @default(18)
  /// The single line-item description printed on the document, e.g.
  /// "Social Media Management for the Month of August". Nullable because
  /// existing rows predate this field; the PDF falls back to a generic line
  /// when it's unset rather than failing to render.
  description        String?
  /// The client's own purchase-order reference, when one exists (e.g. a Work
  /// Order raised through a large client's procurement system) — printed
  /// alongside Payment Terms so the two documents can be reconciled at a
  /// glance. Optional: most proformas (a month card, a proposal advance)
  /// have no PO on the other end at all.
  poNumber           String?
  poDate             DateTime?          @db.Date
  /// SAC/HSN code for the single line item this document bills — the GST
  /// goods/services classification code, e.g. "998382" for photography
  /// services. One code because there's one line item; a real multi-line
  /// proforma would need this per-row instead.
  sacCode            String?
  terms              String             @db.Text

  /// -- CR-02 - printed document ------------------------------------------
  ///
  /// Everything below is a SNAPSHOT, written when the document is raised and
  /// rewritten only while it is still editable. Once a document is paid or
  /// cancelled these values are what it said on the day it was sent, whatever
  /// has happened to the company or the org settings since.
  ///
  /// All nullable because rows predating CR-02 have none. A document with a
  /// null subtotal is rendered from its legacy fields instead, so an old
  /// proforma still prints exactly as it always did.

  /// The buyer state, snapshotted alongside the name and address above.
  billingStateName   String?
  billingStateCode   String?
  /// CR-02 section 4. Captured separately from the buyer state, because it is
  /// the place of supply -- not the billing address -- that decides CGST+SGST
  /// vs IGST, and the two genuinely differ (a Chennai-registered client taking
  /// delivery of an event in Bengaluru). Defaulted from the buyer, never
  /// silently: the form fills it in and lets it be changed.
  placeOfSupplyState String?
  placeOfSupplyCode  String?
  /// Derived from placeOfSupplyCode against the seller state code at raise
  /// time, and stored, so a change to the org GSTIN cannot retroactively turn
  /// an issued CGST+SGST document into an IGST one.
  supplyType         SupplyType?
  /// CR-02 section 4 -- [{ label, value }]. An open list (PO number,
  /// reference, project name) rather than fixed columns, because the next one
  /// nobody has thought of yet should not be a migration.
  customFields       Json?
  /// CR-02 section 9 -- the seller block exactly as printed. Org settings are
  /// read live everywhere else; here they are frozen, or editing the bank
  /// details would silently change what an already-issued invoice claims.
  sellerSnapshot     Json?
  subtotal           Decimal?    @db.Decimal(12, 2)
  cgstAmount         Decimal?    @db.Decimal(12, 2)
  sgstAmount         Decimal?    @db.Decimal(12, 2)
  igstAmount         Decimal?    @db.Decimal(12, 2)
  /// The difference to the nearest whole rupee. Signed: it is as often -0.40
  /// as +0.40, and a document that only ever rounds up does not balance.
  roundOff           Decimal?    @db.Decimal(12, 2)
  total              Decimal?    @db.Decimal(12, 2)
  amountInWords      String?
  notes              String?     @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company      Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoice      Invoice?           @relation(fields: [invoiceId], references: [id])
  milestone    Milestone?         @relation(fields: [milestoneId], references: [id])
  lineItems    DocumentLineItem[]

  // sourceId is a polymorphic pointer, not a foreign key — the same pattern
  // Alert and Activity already use elsewhere in this schema. It used to carry
  // a hard FK to Proposal.id regardless of what sourceType said, which meant
  // MONTH_CARD and PROJECT sources — retainer and project advances, the
  // ordinary case once a proposal has already been won — could never be
  // raised at all; the insert failed with a foreign key violation.

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([companyId])
  @@index([sourceType, sourceId])
  @@map("proformas")
}

// ──────────────────────────────────────────────────────────────────────────────
// 4. RETAINERS, MONTH CARDS & TEMPLATES
// ──────────────────────────────────────────────────────────────────────────────

enum RetainerStatus {
  ACTIVE
  STOPPED
}

model Retainer {
  id               String         @id @default(cuid())
  organizationId   String
  companyId        String
  monthlyValue     Decimal        @db.Decimal(12, 2)
  startDate        DateTime       @db.Date
  termMonths       Int?
  renewalDate      DateTime?      @db.Date
  ownerId          String
  status           RetainerStatus @default(ACTIVE)
  stoppedAt        DateTime?
  stopReason       String?
  /// Set when this retainer is created from a won proposal (§11.1 step 11) —
  /// same handoff pattern as Project.sourceProposalId.
  sourceProposalId String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company      Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  owner        User              @relation("RetainerOwner", fields: [ownerId], references: [id])
  monthCards   MonthCard[]
  projects     RetainerProject[]

  @@index([organizationId, status])
  @@index([companyId])
  @@map("retainers")
}

enum RetainerProjectStatus {
  ACTIVE
  DONE
}

/// A named piece of work inside a retainer.
///
/// A retainer client does not buy "six tasks in September" — they buy a
/// Diwali campaign, an always-on content stream, a brand film. Those run
/// across month boundaries, and until now there was nowhere to say so: tasks
/// hung directly off a MonthCard, so a campaign spanning October and November
/// was some tasks in one month and some more in the next with nothing joining
/// them.
///
/// It carries NO money, deliberately. The retainer is already paid monthly
/// through its month cards; giving this a value would bill the same work
/// twice and put a second revenue figure into every report. That is also why
/// this is its own table rather than a nullable-money variant of Project —
/// Project means one-off work sold for a quoted value, with milestones and
/// its own invoices, and none of that is true here. Two tables that cannot
/// be confused beat one table with a column that decides which thing it is.
model RetainerProject {
  id          String                @id @default(cuid())
  retainerId  String
  name        String
  /// Both nullable: a campaign has dates, an always-on stream does not, and
  /// a null end date is what "ongoing" means rather than a date far away.
  startDate   DateTime?             @db.Date
  endDate     DateTime?             @db.Date
  /// Who is answerable for it. Nullable because the retainer already has an
  /// owner, and naming one per piece of work is useful, not required.
  ownerId     String?
  status      RetainerProjectStatus @default(ACTIVE)
  description String?               @db.Text
  /// The one every retainer has, and the one its work falls into when nothing
  /// else is chosen.
  ///
  /// A retainer task must belong to a project — there is no such thing as
  /// ungrouped retainer work any more — so something has to catch the monthly
  /// baseline: anything created without a project named. Exactly one per retainer, created with
  /// the retainer itself, and it cannot be deleted while it is the default.
  isDefault   Boolean               @default(false)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  retainer Retainer @relation(fields: [retainerId], references: [id], onDelete: Cascade)
  owner    User?    @relation("RetainerProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  tasks    Task[]

  @@index([retainerId, status])
  @@map("retainer_projects")
}

enum MonthCardStatus {
  OPEN
  CLOSED
}

model MonthCard {
  id         String          @id @default(cuid())
  retainerId String
  month      String // "YYYY-MM"
  revenue    Decimal         @db.Decimal(12, 2)
  status     MonthCardStatus @default(OPEN)
  invoiceId  String?         @unique
  closedAt   DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  retainer       Retainer           @relation(fields: [retainerId], references: [id], onDelete: Cascade)
  invoice        Invoice?           @relation(fields: [invoiceId], references: [id])
  tasks          Task[]
  costs          Cost[]
  allocations    PeopleAllocation[]
  assetMovements AssetMovement[]

  @@unique([retainerId, month])
  @@index([month, status])
  @@map("month_cards")
}


// ──────────────────────────────────────────────────────────────────────────────
// 5. PROJECTS & MILESTONES
// ──────────────────────────────────────────────────────────────────────────────

enum ProjectStatus {
  LIVE
  DELIVERED
  CANCELLED
}

// Shared across Project and Task so both can be compared/sorted on one
// "what needs attention" scale. Not in the prototype — it derives urgency
// from due-date bucketing and elapsed-vs-median instead — but real usage
// wants a settable signal too, so both live side by side.
enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Project {
  id               String        @id @default(cuid())
  organizationId   String
  companyId        String
  name             String
  quotedValue      Decimal       @db.Decimal(12, 2)
  estimatedCost    Decimal?      @db.Decimal(12, 2)
  startDate        DateTime      @db.Date
  endDate          DateTime      @db.Date
  ownerId          String
  status           ProjectStatus @default(LIVE)
  priority         Priority      @default(MEDIUM)
  description      String?       @db.Text
  sourceProposalId String?
  deletedAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company        Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  owner          User               @relation("ProjectOwner", fields: [ownerId], references: [id])
  milestones     Milestone[]
  tasks          Task[]
  costs          Cost[]
  allocations    PeopleAllocation[]
  invoices       Invoice[]
  assetMovements AssetMovement[]

  @@index([organizationId, status])
  @@index([companyId])
  @@map("projects")
}

enum MilestoneStatus {
  PENDING
  PROFORMA_RAISED
  INVOICED
  PAID
}

model Milestone {
  id        String          @id @default(cuid())
  projectId String
  label     String
  percent   Int
  amount    Decimal         @db.Decimal(12, 2)
  status    MilestoneStatus @default(PENDING)
  order     Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  proformas Proforma[]

  @@index([projectId, order])
  @@map("milestones")
}

// ──────────────────────────────────────────────────────────────────────────────
// 6. TASKS & TIME CLOCK ENGINE
// ──────────────────────────────────────────────────────────────────────────────

enum TaskWorkType {
  MONTH_CARD
  PROJECT
  INTERNAL
}

// TODO/IN_PROGRESS both mean "open, clock running from assignedAt" — the
// split is a triage label, not a second clock state; nothing about §11.4's
// "nobody starts a timer" changes. ON_HOLD is the old WAITING, renamed —
// same waitingOn/waitingSince/waitingTotalMinutes pause underneath it.
// CANCELLED is new: a real terminal state distinct from DONE, excluded
// from open-task and turnaround-average counts the same way DONE tasks
// that were actually finished are not — see tasks.ts/team.ts for where
// that exclusion is applied.
/// Which kind of work a task is, using the same names the team is split into
/// (User.dept). Deliberately the
/// department vocabulary rather than a new one: a studio that already says
/// "that's a Design job" does not need to learn a second word for it.
enum TaskType {
  DESIGN
  VIDEO
  DIGITAL_MARKETING
  DEVELOPMENT
  BUSINESS_DEVELOPMENT
  ACCOUNTS
  MANAGEMENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  ON_HOLD
  DONE
  CANCELLED
}

/// Everybody working on a task, the lead included.
///
/// A join table rather than a second id column, because "who is on this" has
/// no natural limit and a `assignee2Id`, `assignee3Id` schema answers the
/// question wrong the first time somebody needs a fourth person.
///
/// Load is counted from HERE, not from `Task.assigneeId`: three people sharing
/// a task are three busy people, and counting it against the lead alone is how
/// the two helping look idle. Organisation-wide totals still count the task
/// once — the same figure means a different thing per person and per company,
/// and this is the seam where that distinction lives.
model TaskAssignee {
  id         String   @id @default(cuid())
  taskId     String
  userId     String
  assignedAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation("TaskAssignments", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([userId])
  @@map("task_assignees")
}

enum WaitingOn {
  CLIENT
  ANOTHER_PERSON
}

model Task {
  id                String       @id @default(cuid())
  organizationId    String
  title             String
  workType          TaskWorkType
  workId            String?
  monthCardId       String?
  projectId         String?
  /// Which piece of retainer work this task is part of.
  ///
  /// Set ALONGSIDE monthCardId, never instead of it. The month card is which
  /// month the task is billed and costed in; this is what the task is FOR.
  /// A campaign running October into November is one project whose tasks sit
  /// in two different month cards, and both facts have to survive.
  retainerProjectId String?
  /// The lead. Kept alongside `assignees` rather than replaced by it: forty
  /// reads across nine files ask "whose task is this", a task always has
  /// somebody answerable for it, and a nullable set is a worse answer to that
  /// question than a column. Always also present in `assignees`.
  assigneeId        String
  /// Who typed it in. Always the caller, never chosen — `canRemove` grants
  /// deleting a task to whoever created it, so a picker here would be a
  /// permission anybody could hand to anybody. For who ASKED for the work,
  /// see `assignedById`.
  createdById       String
  /// Who handed the work over.
  ///
  /// This used to be `createdById`, which is only the same person when the
  /// person who wants the work done is also the person who types it up. A
  /// manager writing out what a Head asked for in a meeting could not say so,
  /// and the task arrived on somebody's screen attributed to the wrong person.
  ///
  /// Null when nobody handed it over, which is most tasks: somebody writing
  /// out their own work was not asked to do it by themselves. It used to
  /// default to the caller, so every task carried a value and the field said
  /// nothing. `createdById` records who typed it either way, and the task
  /// drawer falls back to that when this is empty.
  assignedById      String?
  /// Who checks it before it counts as done. Optional: most tasks are not
  /// reviewed, and pretending otherwise would put a required picker on every
  /// creation form.
  reviewerId        String?
  taskType          TaskType?
  dueDate           DateTime     @db.Date

  assignedAt          DateTime   @default(now())
  completedAt         DateTime?
  status              TaskStatus @default(TODO)
  priority            Priority   @default(MEDIUM)
  waitingOn           WaitingOn?
  waitingSince        DateTime?
  waitingTotalMinutes Int        @default(0)
  reopenCount         Int        @default(0)
  notes               String?    @db.Text
  // §16: soft delete only, nothing hard deleted by a user. A task entered by
  // mistake leaves; a task somebody worked stays and gets Cancelled instead,
  // because the aging medians, the allocation cron and "done this week" all
  // read history that a hard delete would silently rewrite.
  deletedAt           DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignee        User             @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creator         User             @relation("TaskCreator", fields: [createdById], references: [id])
  assignedBy      User?            @relation("TaskAssignedBy", fields: [assignedById], references: [id])
  reviewer        User?            @relation("TaskReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  assignees       TaskAssignee[]
  monthCard       MonthCard?       @relation(fields: [monthCardId], references: [id], onDelete: Cascade)
  project         Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// SetNull, not Cascade: deleting a piece of retainer work must not delete
  /// the tasks that were done under it. They stay on their month card, which
  /// is where the month's cost and profit are counted from.
  retainerProject RetainerProject? @relation(fields: [retainerProjectId], references: [id], onDelete: SetNull)

  @@index([organizationId, assigneeId, status])
  @@index([dueDate, status])
  @@index([monthCardId])
  @@index([projectId])
  @@index([retainerProjectId])
  @@map("tasks")
}

// ──────────────────────────────────────────────────────────────────────────────
// 7. FINANCIALS, COSTS & ALLOCATIONS
// ──────────────────────────────────────────────────────────────────────────────

enum CostType {
  DIRECT
  COMPANY
  CAPITAL
}

enum CostPaidBy {
  COMPANY
  AKMAL
  JAMEEL_N_J_MACSON
}

enum CostTreatment {
  COMPANY_EXPENSE
  AKMAL_LOAN
  N_J_MACSON_LOAN
}

model Cost {
  id                String        @id @default(cuid())
  organizationId    String
  type              CostType
  workType          TaskWorkType?
  workId            String?
  monthCardId       String?
  projectId         String?
  category          String
  vendor            String
  amount            Decimal       @db.Decimal(12, 2)
  incurredAt        DateTime      @db.Date
  committedNotPaid  Boolean       @default(false)
  paidBy            CostPaidBy    @default(COMPANY)
  treatment         CostTreatment @default(COMPANY_EXPENSE)
  enteredById       String
  recurring         Boolean       @default(false)
  // Set on the clone the 00:15-on-the-1st job creates from a recurring row,
  // pointing back at the row it was cloned from — how the job tells "already
  // rolled this month" from "needs a new draft" without a separate table.
  recurringSourceId String?
  confirmed         Boolean       @default(true)
  notes             String?       @db.Text
  deletedAt         DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enteredBy        User               @relation("CostEnteredBy", fields: [enteredById], references: [id])
  monthCard        MonthCard?         @relation(fields: [monthCardId], references: [id], onDelete: SetNull)
  project          Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  recurringSource  Cost?              @relation("RecurringCostClones", fields: [recurringSourceId], references: [id], onDelete: SetNull)
  recurringClones  Cost[]             @relation("RecurringCostClones")
  assets           Asset[]
  assetMaintenance AssetMaintenance[]

  @@index([organizationId, type])
  @@index([monthCardId])
  @@index([projectId])
  @@index([incurredAt])
  @@map("costs")
}

model PeopleAllocation {
  id              String       @id @default(cuid())
  userId          String
  month           String // "YYYY-MM"
  workType        TaskWorkType
  workId          String
  monthCardId     String?
  projectId       String?
  proposedPercent Int
  percent         Int // Percentages only, never stores INR
  confirmedById   String?
  confirmedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user        User       @relation("UserAllocations", fields: [userId], references: [id], onDelete: Cascade)
  confirmedBy User?      @relation("AllocationConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  monthCard   MonthCard? @relation(fields: [monthCardId], references: [id], onDelete: Cascade)
  project     Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, month, workId])
  @@index([month, workId])
  @@map("people_allocations")
}

enum InvoiceStatus {
  RAISED
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  number         String // Entered from Tally
  companyId      String
  workType       TaskWorkType?
  workId         String?
  amount         Decimal       @db.Decimal(12, 2)
  raisedAt       DateTime      @db.Date
  dueAt          DateTime      @db.Date
  status         InvoiceStatus @default(RAISED)
  paidAt         DateTime?     @db.Date
  proformaId     String?       @unique
  projectId      String?

  /// The buyer block, snapshotted at entry -- the same four fields, under the
  /// same names, as Proforma carries, so one renderer serves both.
  billingName        String?
  billingContactName String?
  billingAddress     String?   @db.Text
  gstin              String?
  gstApplicable      Boolean   @default(true)
  gstRatePercent     Int       @default(18)
  poNumber           String?
  poDate             DateTime? @db.Date
  /// This document's own terms. Nullable, unlike Proforma.terms, because an
  /// invoice recorded before CR-02 has none and falls back to the org list.
  terms              String?   @db.Text

  /// -- CR-02 - printed document ------------------------------------------
  ///
  /// Everything below is a SNAPSHOT, written when the document is raised and
  /// rewritten only while it is still editable. Once a document is paid or
  /// cancelled these values are what it said on the day it was sent, whatever
  /// has happened to the company or the org settings since.
  ///
  /// All nullable because rows predating CR-02 have none. A document with a
  /// null subtotal is rendered from its legacy fields instead, so an old
  /// proforma still prints exactly as it always did.

  /// The buyer state, snapshotted alongside the name and address above.
  billingStateName   String?
  billingStateCode   String?
  /// CR-02 section 4. Captured separately from the buyer state, because it is
  /// the place of supply -- not the billing address -- that decides CGST+SGST
  /// vs IGST, and the two genuinely differ (a Chennai-registered client taking
  /// delivery of an event in Bengaluru). Defaulted from the buyer, never
  /// silently: the form fills it in and lets it be changed.
  placeOfSupplyState String?
  placeOfSupplyCode  String?
  /// Derived from placeOfSupplyCode against the seller state code at raise
  /// time, and stored, so a change to the org GSTIN cannot retroactively turn
  /// an issued CGST+SGST document into an IGST one.
  supplyType         SupplyType?
  /// CR-02 section 4 -- [{ label, value }]. An open list (PO number,
  /// reference, project name) rather than fixed columns, because the next one
  /// nobody has thought of yet should not be a migration.
  customFields       Json?
  /// CR-02 section 9 -- the seller block exactly as printed. Org settings are
  /// read live everywhere else; here they are frozen, or editing the bank
  /// details would silently change what an already-issued invoice claims.
  sellerSnapshot     Json?
  subtotal           Decimal?    @db.Decimal(12, 2)
  cgstAmount         Decimal?    @db.Decimal(12, 2)
  sgstAmount         Decimal?    @db.Decimal(12, 2)
  igstAmount         Decimal?    @db.Decimal(12, 2)
  /// The difference to the nearest whole rupee. Signed: it is as often -0.40
  /// as +0.40, and a document that only ever rounds up does not balance.
  roundOff           Decimal?    @db.Decimal(12, 2)
  total              Decimal?    @db.Decimal(12, 2)
  amountInWords      String?
  notes              String?     @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company      Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project      Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  proforma     Proforma?          @relation
  monthCard    MonthCard?         @relation
  payments     Payment[]
  lineItems    DocumentLineItem[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([companyId])
  @@map("invoices")
}

/// Whether a supply is within the seller's own state or across a border. The
/// whole of CR-02 section 6 turns on this one distinction.
enum SupplyType {
  INTRA
  INTER
}

/// CR-02 section 5 -- one row of a document's items table.
///
/// The spec asked for a polymorphic (documentType, documentId) pair. This uses
/// two nullable foreign keys instead, with a constraint that exactly one is
/// set: a real key gets cascade delete and referential integrity for free,
/// where a loose uuid gets orphan rows the day a document is deleted. Which
/// kind of document a row belongs to is then a fact about which column is
/// filled, rather than a second copy of that fact that can disagree with it.
model DocumentLineItem {
  id          String   @id @default(cuid())
  proformaId  String?
  invoiceId   String?
  /// 1, 2, 3 ... in print order. Assigned by the server from array position on
  /// every write, never sent by the client, so deleting row 2 renumbers the
  /// rest instead of leaving a gap.
  serialNo    Int
  particulars String   @db.Text
  /// Three decimal places: agency work is billed in halves and quarters of a
  /// day often enough that two is not always enough.
  units       Decimal  @db.Decimal(12, 3)
  unitCost    Decimal  @db.Decimal(12, 2)
  hsnSac      String?
  /// units x unitCost, computed server-side and stored. Stored rather than
  /// derived on read because it is part of the frozen document: a rounding
  /// rule that changes later must not change what an issued invoice says.
  amount      Decimal  @db.Decimal(12, 2)
  gstRate     Int      @default(18)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  proforma Proforma? @relation(fields: [proformaId], references: [id], onDelete: Cascade)
  invoice  Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([proformaId, serialNo])
  @@index([invoiceId, serialNo])
  @@map("document_line_items")
}

model Payment {
  id         String   @id @default(cuid())
  invoiceId  String
  amount     Decimal  @db.Decimal(12, 2)
  receivedAt DateTime @db.Date
  mode       String
  reference  String?
  createdAt  DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("payments")
}

// ──────────────────────────────────────────────────────────────────────────────
// 8. ALERTS & AUDIT TRAIL
// ──────────────────────────────────────────────────────────────────────────────

enum AlertSeverity {
  HIGH
  MED
  LOW
}

model Alert {
  id               String        @id @default(cuid())
  organizationId   String
  rule             String
  severity         AlertSeverity
  entityType       String
  entityId         String
  message          String
  raisedAt         DateTime      @default(now())
  resolvedAt       DateTime?
  acknowledgedById String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  acknowledgedBy User?        @relation("AlertAcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: SetNull)
  reads          AlertRead[]

  @@index([organizationId, resolvedAt, severity])
  @@index([entityType, entityId])
  @@map("alerts")
}

/// Who has DISMISSED an alert from their own bell.
///
/// `Alert.acknowledgedById` already existed and looks like it does this job.
/// It does not: it is a single column on a row shared by the whole
/// organisation, so the first person to press "Mark all read" cleared the
/// badge for all fourteen people at once. On the live database 41 of 44 open
/// alerts were already stamped with one manager's id, which is why every role
/// — founder, head, BD, designer — saw an identical unread count of 3.
///
/// Acknowledgement and reading are genuinely different facts, so both stay:
/// acknowledging is the organisation saying somebody has taken this on, and a
/// read is one person saying they have seen it.
model AlertRead {
  id      String   @id @default(cuid())
  alertId String
  userId  String
  readAt  DateTime @default(now())

  alert Alert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([alertId, userId])
  @@index([userId])
  @@map("alert_reads")
}

model Activity {
  id             String   @id @default(cuid())
  organizationId String
  entityType     String
  entityId       String
  actorId        String?
  verb           String
  payload        Json     @default("{}")
  at             DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation("ActorActivity", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, entityType, entityId, at])
  @@map("activities")
}

// ──────────────────────────────────────────────────────────────────────────────
// 10. COMPANY ASSETS — the register, and who is holding what
//
// Reference: docs/ASSET_MANAGEMENT_PLAN.md
//
// Two problems, one table. CUSTODY answers "who is responsible for this?" — a
// laptop with a designer, open-ended, changing about once a year. BOOKING
// answers "is the 24-70 free on Friday, and did it come back?" — a due date,
// and therefore an overdue. Tools that merge them become useless at both, and
// tools that split them into two tables lose the one thing you actually want
// when a lens goes missing: a single chronological chain of custody.
//
// There are no file uploads here. Attachments were built and withdrawn on
// 2026-08-05 (PRODUCT_GAPS.md) because they had no per-org quota and a full
// disk on a single VPS also stops Postgres writing. Bills, warranty cards and
// photos are therefore URL strings pointing at Drive, following the existing
// driveLink / receiptUrl convention. That is a schema decision, not a phase 2.
// ──────────────────────────────────────────────────────────────────────────────

enum AssetCategory {
  LAPTOP
  DESKTOP
  MONITOR
  PHONE
  STORAGE // SSDs, HDDs, card readers
  NETWORK // routers, switches, dongles
  CAMERA_BODY
  LENS
  LIGHTING
  AUDIO // mics, recorders, boom poles
  GIMBAL_DRONE
  SUPPORT // tripods, sliders, monopods
  ACCESSORY // batteries, cards, bags
  OTHER
}

enum AssetStatus {
  IN_STOCK // in the office, free to take
  ASSIGNED // with a person, long-term custody
  BOOKED_OUT // out on a shoot, expected back
  IN_REPAIR
  RETIRED // written off, still on the books at salvage
  SOLD
  LOST
}

enum AssetCondition {
  NEW
  GOOD
  FAIR
  DAMAGED
}

enum AssetMovementKind {
  CUSTODY // long-term assignment, no due date
  BOOKING // short-term checkout, has dueAt
}

enum AssetMaintenanceKind {
  SERVICE
  REPAIR
  AMC
}

model Asset {
  id             String @id @default(cuid())
  organizationId String

  // Identity
  tag          String // "EL/CAM/001" — printed on the sticker
  name         String // "Sony A7 IV"
  category     AssetCategory
  make         String?
  model        String?
  /// Deliberately NOT unique-constrained. Plenty of genuine kit ships without
  /// one, and a partial unique index on a nullable column is a foot-gun.
  /// Duplicates are surfaced as a warning at create time instead.
  serialNumber String?

  status    AssetStatus    @default(IN_STOCK)
  condition AssetCondition @default(GOOD)

  /// Does this item go out on shoots? Drives whether the booking actions and
  /// the "Out now" board offer it at all. A monitor is never bookable; a lens
  /// always is. Kept as a flag rather than inferred from category so an
  /// office-bound spare laptop can be excluded by hand.
  bookable Boolean @default(false)

  // ─── Money ───────────────────────────────────────────────────────────────
  /// The CAPITAL Cost row that bought this. The asset does NOT own the spend —
  /// it points at the single place the money was already recorded, so the
  /// register and the P&L can never disagree about what was paid.
  costId           String?
  purchasePrice    Decimal   @db.Decimal(12, 2)
  purchasedAt      DateTime  @db.Date
  vendor           String?
  invoiceNumber    String?
  /// Straight-line inputs. Defaulted per category from ASSET_USEFUL_LIFE in
  /// @flowzen/shared, overridable per asset because the CA occasionally
  /// disagrees with the default for one specific purchase.
  usefulLifeMonths Int
  salvageValue     Decimal   @default(0) @db.Decimal(12, 2)
  /// Set only when status becomes SOLD — what it actually fetched, which is
  /// rarely the book value and is what a gain/loss line needs.
  disposedAt       DateTime? @db.Date
  disposalValue    Decimal?  @db.Decimal(12, 2)
  disposalNote     String?

  warrantyUntil DateTime? @db.Date
  insuredUntil  DateTime? @db.Date

  // ─── Links, not uploads ──────────────────────────────────────────────────
  billUrl  String?
  photoUrl String?
  notes    String? @db.Text

  /// Denormalised pointer to whoever holds it, so the register list can render
  /// 200 rows without an N+1 over movement history. The open AssetMovement row
  /// remains the source of truth; one writer keeps the two in step.
  currentHolderId String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  organization  Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cost          Cost?              @relation(fields: [costId], references: [id], onDelete: SetNull)
  currentHolder User?              @relation("AssetHolder", fields: [currentHolderId], references: [id], onDelete: SetNull)
  movements     AssetMovement[]
  maintenance   AssetMaintenance[]

  @@unique([organizationId, tag])
  @@index([organizationId, status])
  @@index([organizationId, category])
  @@index([currentHolderId])
  @@map("assets")
}

/// The chain of custody.
///
/// INVARIANT: an asset has at most ONE movement with `returnedAt: null`.
/// Enforced in the service layer inside a transaction, not by a constraint —
/// Postgres cannot express "at most one null per group" without a partial
/// unique index, and the transaction is the honest place for it anyway since
/// Asset.status and Asset.currentHolderId must move in the same commit.
model AssetMovement {
  id      String            @id @default(cuid())
  assetId String
  kind    AssetMovementKind
  userId  String // who is holding it

  /// BOOKING only — what the gear went out for. Both nullable: plenty of
  /// shoots are internal or pre-sales and belong to no billable work item.
  projectId   String?
  monthCardId String?
  purpose     String?

  outAt      DateTime  @default(now())
  /// Null for CUSTODY (open-ended). Required for BOOKING — it is what makes
  /// an overdue alert possible at all.
  dueAt      DateTime?
  returnedAt DateTime?

  issuedById   String
  receivedById String?
  conditionOut AssetCondition
  conditionIn  AssetCondition?
  notes        String?         @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  asset      Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user       User       @relation("AssetMovementHolder", fields: [userId], references: [id])
  issuedBy   User       @relation("AssetMovementIssuer", fields: [issuedById], references: [id])
  receivedBy User?      @relation("AssetMovementReceiver", fields: [receivedById], references: [id], onDelete: SetNull)
  project    Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  monthCard  MonthCard? @relation(fields: [monthCardId], references: [id], onDelete: SetNull)

  @@index([assetId, outAt])
  @@index([userId, returnedAt])
  @@index([returnedAt, dueAt]) // the overdue scan
  @@map("asset_movements")
}

model AssetMaintenance {
  id          String               @id @default(cuid())
  assetId     String
  kind        AssetMaintenanceKind
  vendor      String?
  /// Repair spend. Optionally mirrored into a COMPANY Cost row — off by
  /// default, because small repairs are noise in the P&L and the maintenance
  /// log holds the number either way.
  amount      Decimal?             @db.Decimal(12, 2)
  costId      String?
  sentAt      DateTime             @db.Date
  returnedAt  DateTime?            @db.Date
  notes       String?              @db.Text
  createdById String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  asset     Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  cost      Cost? @relation(fields: [costId], references: [id], onDelete: SetNull)
  createdBy User  @relation("MaintenanceCreator", fields: [createdById], references: [id])

  @@index([assetId, sentAt])
  @@map("asset_maintenance")
}
